<Window x:Class="ThaiKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thai Virtual Keyboard" Height="650" Width="950"
        Background="#2274B5" Foreground="White"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style TargetType="Button" x:Key="KeyButtonStyle">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderThickness="1" 
                                BorderBrush="#A5A5A5"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Button" x:Key="TranslateButtonStyle">
            <Setter Property="Background" Value="#307E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Translation Area -->
        <Grid Grid.Row="0" Margin="15" x:Name="TranslationGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thai Side -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Thai (ไทย)" Foreground="White" FontSize="18" Margin="0,0,0,5"/>
                <Border Grid.Row="1" Background="White" CornerRadius="0" Height="160">
                    <Grid>
                        <TextBox x:Name="SourceTextBox" BorderThickness="0" Background="Transparent" Foreground="Black" FontSize="20" Padding="10" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <Button Content="文A TRANSLATE" Style="{StaticResource TranslateButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="Translate_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Indonesian Side -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox SelectedIndex="0" Margin="0,0,0,5" Height="28" FontSize="16">
                    <ComboBoxItem Content="Indonesian (ภาษาอินโดนีเซีย)"/>
                </ComboBox>
                <Border Grid.Row="1" Background="White" CornerRadius="0" Height="160">
                    <Grid>
                        <TextBox x:Name="TargetTextBox" BorderThickness="0" Background="Transparent" Foreground="Black" FontSize="20" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
                            <!-- Copy Button -->
                            <Button Content="📋" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Click="CopyTarget_Click" ToolTip="Copy" Margin="0,0,10,0"/>
                            <!-- Clear Button -->
                            <Button Content="🗑️" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Click="ClearText_Click" ToolTip="Clear"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Keyboard Area -->
        <Border Grid.Row="1" Background="#D5D9E0" CornerRadius="10,10,0,0" Margin="15,0,15,0" Padding="10,15,10,0">
            <Grid>
                <!-- Standard Keyboard -->
                <ItemsControl x:Name="KeyboardItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayText}" Width="{Binding Width}" Height="55" Style="{StaticResource KeyButtonStyle}" Click="KeyButton_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Emoji Picker -->
                <Grid x:Name="EmojiGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Emoji Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <!-- Category Icons (Simplified as text) -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Button Content="🕒" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="😀" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="🐶" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="🍎" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="⚽" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="🚗" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="💡" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="🔣" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,0,10,0"/>
                            <Button Content="🏳️" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="Gray"/>
                        </StackPanel>
                        <!-- Search Box -->
                        <TextBox x:Name="EmojiSearchBox" Grid.Column="1" Padding="5" FontSize="14" ToolTip="Search emojis (Mock)"/>
                    </Grid>
                    
                    <!-- Emoji Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EmojiItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" Foreground="#666666" Margin="5,0,0,5" FontSize="16"/>
                                        <ItemsControl ItemsSource="{Binding Emojis}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" FontSize="24" Width="42" Height="42" Background="Transparent" BorderThickness="0" Click="EmojiButton_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Back Button Floating -->
                    <Button Grid.Row="1" Content="⬅ ⌨" Width="70" Height="45" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Background="#C0C0C0" FontSize="20" Click="BackToKeyboard_Click" ToolTip="Back to keyboard">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="#999999">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#A0A0A0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom Status Bar inside the gray area -->
        <Border Grid.Row="2" Background="#D5D9E0" Margin="15,0,15,15" Padding="10" CornerRadius="0,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="DirectInputToggle" Content="Direct Input Mode" FontSize="16" Foreground="Black" Checked="ToggleMode_Changed" Unchecked="ToggleMode_Changed" ToolTip="Toggle between typing in the app and typing into external windows"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Physical keyboard: " Foreground="Black" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="0" Width="120" Margin="0,0,10,0">
                        <ComboBoxItem Content="QWERTY (Default)"/>
                    </ComboBox>
                    <TextBlock Text="On-screen keyboard: " Foreground="Black" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="0" Width="120">
                        <ComboBoxItem Content="Thai Kedmanee"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
